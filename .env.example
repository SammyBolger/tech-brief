# Anthropic API. The agent summarizes stories with Claude Haiku 4.5.
# Get a key at https://console.anthropic.com and set a monthly cap of $2.
ANTHROPIC_API_KEY=

# Resend. Free tier is 100 emails per day. Get a key at https://resend.com.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=brief@yourdomain.com
DIGEST_TO_EMAIL=you@example.com

# Optional overrides
# REVIEW_MODEL=claude-haiku-4-5-20251001
# HOURS_LOOKBACK=24
# MAX_STORIES_PER_SOURCE=50
# LOG_LEVEL=INFO
